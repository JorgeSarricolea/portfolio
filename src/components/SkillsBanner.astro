---
import skillsByCategory from "@/js/objects/skills.js";

// Enforce custom category order using a hash table
const categoryOrderIndex = {
  "Languages \ud83c\udf1f": 1,
  "Back-End \u2699\ufe0f": 2,
  "Databases \ud83d\uddc4\ufe0f": 3,
  "Front-End \ud83c\udfa8": 4,
  "Cloud \u2601\ufe0f": 5,
  "CI/CD \ud83d\ude80": 6,
  "Testing & Tools \ud83d\udd0d": 7,
  "Blockchain \u26d3\ufe0f": 8,
} as Record<string, number>;

const orderedCategories = [...skillsByCategory].sort(
  (a, b) =>
    (categoryOrderIndex[a.title] ?? 999) - (categoryOrderIndex[b.title] ?? 999)
);

// Flat list of skills in the specified order
const bannerItems = orderedCategories.flatMap((category) => category.items);
---

<section
  id="skills-banner"
  class="w-full py-8 md:py-20 my-10 md:my-20 bg-gray bg-opacity-50 backdrop-blur-sm"
>
  <div class="overflow-hidden mask-fade-x">
    <div
      class="flex animate-scroll w-max gap-8 md:gap-16 items-center will-change-transform"
    >
      {
        bannerItems.map((item) => (
          <div class="flex-shrink-0 flex items-center gap-2 md:gap-3">
            <img
              src={`/icons/${item.icon}`}
              alt={item.name}
              class="w-10 h-10 md:w-12 md:h-12 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
              loading="lazy"
              onerror="this.onerror=null;this.src='/icons/circularIcon.png'"
            />
            <span class="text-white/80 text-sm md:text-base whitespace-nowrap">
              {item.name}
            </span>
          </div>
        ))
      }
      {
        bannerItems.map((item) => (
          <div class="flex-shrink-0 flex items-center gap-2 md:gap-3">
            <img
              src={`/icons/${item.icon}`}
              alt={item.name}
              class="w-10 h-10 md:w-12 md:h-12 object-contain opacity-80 hover:opacity-100 transition-opacity duration-300"
              loading="lazy"
              onerror="this.onerror=null;this.src='/icons/circularIcon.png'"
            />
            <span class="text-white/80 text-sm md:text-base whitespace-nowrap">
              {item.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-scroll {
    animation: scroll 45s linear infinite;
  }

  .animate-scroll:hover {
    animation-play-state: paused;
  }

  .mask-fade-x {
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 8%,
      black 92%,
      transparent
    );
  }

  @media (max-width: 768px) {
    .animate-scroll {
      animation-duration: 30s;
    }
  }
</style>
