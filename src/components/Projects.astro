---
import projects from "@/js/objects/projects.js";
import tags from "@/js/objects/tags.js";

const findTag = (tagId: string) => {
  for (const category of Object.values(tags)) {
    if (category[tagId]) {
      return category[tagId];
    }
  }
  return null;
};
---

<section id="projects" class="w-full md:max-w-full md:px-0 px-8">
  <h1
    class="text-primary md:text-5xl text-3xl font-bold text-center md:my-20 my-8 uppercase"
  >
    Projects
  </h1>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      projects.map((project) => (
        <div class="flex flex-col bg-gray rounded-2xl shadow-primary overflow-hidden transition-transform duration-300 hover:scale-[1.02]">
          <div class="relative h-48 overflow-hidden">
            <img
              src={project.image}
              alt={project.title}
              class="w-full h-full object-cover transition-transform duration-300 hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
          </div>
          <div class="p-8">
            <div class="flex justify-between items-start">
              <div class="mb-4">
                <h3 class="text-primary font-bold text-xl uppercase">
                  {project.title}
                </h3>
              </div>
              <div class="flex gap-3">
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    class="text-white hover:text-primary transition-colors duration-300"
                  >
                    <i class="fa-solid fa-up-right-from-square" />
                  </a>
                )}
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    class="text-white hover:text-primary transition-colors duration-300"
                  >
                    <i class="fa-brands fa-github" />
                  </a>
                )}
              </div>
            </div>
            <p class="text-white mt-2 line-clamp-3">{project.description}</p>
            <div class="flex flex-wrap gap-2 mt-4">
              {project.tagIds &&
                project.tagIds.map((tagId: string) => {
                  const tag = findTag(tagId);
                  return tag ? (
                    <div class="flex w-fit h-fit center text-primary bg-secondary rounded-lg p-1 pr-2 items-center">
                      <img
                        src={tag.image}
                        alt={tag.name}
                        class="h-6 bg-black rounded"
                      />
                      <p class="h-fit w-fit ml-2 text-xs">{tag.name}</p>
                    </div>
                  ) : null;
                })}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
