---
import ProfilePhoto from "@/components/ProfilePhoto.astro";
---

<main class="min-h-screen flex items-center justify-center px-6">
  <div class="max-w-5xl w-full flex flex-col-reverse md:flex-row items-center gap-12 md:gap-20">
    <div class="flex-1 text-center md:text-left">
      <div data-hero="text">
        <p class="text-primary font-mono text-sm mb-3 tracking-wide">Hi, I'm</p>
        <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight mb-4">
          Jorge<br />Sarricolea<span class="text-amber">.</span>
        </h1>
      </div>

      <p data-hero="subtitle" class="text-xl md:text-2xl text-gray-400 mb-2 min-h-[2rem]">
        <span id="multiText" class="text-primary font-semibold"></span>
      </p>

      <p data-hero="desc" class="text-gray-500 text-base md:text-lg max-w-lg mt-4 leading-relaxed">
        Full-stack engineer — React, TypeScript, NestJS, and scalable APIs. Remote-first, quality-driven delivery.
      </p>

      <div data-hero="socials" class="flex items-center gap-5 mt-8 justify-center md:justify-start">
        <a href="https://github.com/JorgeSarricolea" target="_blank" rel="noopener noreferrer"
          class="text-gray-500 hover:text-primary hover:-translate-y-1 transition-all duration-300" aria-label="GitHub">
          <i class="fab fa-github text-2xl"></i>
        </a>
        <a href="https://linkedin.com/in/jorgesarricolea" target="_blank" rel="noopener noreferrer"
          class="text-gray-500 hover:text-primary hover:-translate-y-1 transition-all duration-300" aria-label="LinkedIn">
          <i class="fab fa-linkedin text-2xl"></i>
        </a>
        <a href="https://instagram.com/jorgesarricolea_" target="_blank" rel="noopener noreferrer"
          class="text-gray-500 hover:text-primary hover:-translate-y-1 transition-all duration-300" aria-label="Instagram">
          <i class="fab fa-instagram text-2xl"></i>
        </a>
      </div>
    </div>

    <div data-hero="photo">
      <ProfilePhoto />
    </div>
  </div>
</main>
