---
import personalInfo from "@/js/objects/personal_info.js";
---

<main
  class="text-white md:bg-gray rounded-3xl md:flex md:flex-col md:shadow-primary"
>
  <div class="md:flex md:px-20 md:pt-20 md:gap-20">
    <div
      class="flex flex-col justify-between md:w-9/12 md:mb-20 mb-8 mx-8 md:mx-0 gap-4"
    >
      <h1
        id="mainTitle"
        class="md:text-5xl text-5xl min-h-[9rem] md:min-h-[8rem] mb-4"
      >
        I'm
        <span id="multiText" class="text-primary font-bold inline"></span>
      </h1>
      <p class="text-xl">
        {personalInfo.basics.label}
      </p>

      <!-- Social Media Icons -->
      <div class="flex gap-6 mt-6">
        <!-- GitHub -->
        <a
          href="https://github.com/JorgeSarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-github"></i>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/jorgesarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-linkedin"></i>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com/jorgesarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-instagram"></i>
        </a>
      </div>
    </div>
    <div
      class="flex justify-center md:justify-start md:w-auto mx-8 md:mx-0 mb-0"
    >
      <img
        id="hero"
        src=""
        alt=""
        width="600"
        height="600"
        class="shrink-0 aspect-square w-full md:w-64 lg:w-72 xl:w-80 object-contain md:rounded-none rounded-2xl md:bg-transparent bg-primary backdrop-blur bg-opacity-75"
      />
    </div>
  </div>
</main>

<style>
  #hero {
    -webkit-mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 60%,
      rgba(0, 0, 0, 0) 95%
    );
    mask-image: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 1) 60%,
      rgba(0, 0, 0, 0) 95%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: top;
    mask-position: top;
  }
</style>
