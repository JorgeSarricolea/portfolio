---
import personalInfo from "@/js/objects/personal_info.js";
---

<main
  class="text-white md:bg-gray rounded-3xl md:flex md:flex-col md:shadow-primary"
>
  <div class="md:flex md:px-20 md:pt-20 gap-20">
    <div
      class="flex flex-col justify-between md:w-9/12 md:mb-20 mb-8 mx-8 md:mx-0 gap-4"
    >
      <h1 id="mainTitle" class="md:text-6xl text-5xl min-w-5/6 h-36">
        I'm <span id="multiText" class="text-primary font-bold"></span>
      </h1>
      <p class="text-xl">
        {personalInfo.basics.label}
      </p>

      <!-- Social Media Icons -->
      <div class="flex gap-6 mt-6">
        <!-- GitHub -->
        <a
          href="https://github.com/JorgeSarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-github"></i>
        </a>

        <!-- LinkedIn -->
        <a
          href="https://linkedin.com/in/jorgesarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-linkedin"></i>
        </a>

        <!-- Instagram -->
        <a
          href="https://instagram.com/jorgesarricolea"
          target="_blank"
          rel="noopener noreferrer"
          class="text-2xl text-gray-400 hover:text-primary transition-colors duration-300"
        >
          <i class="fab fa-instagram"></i>
        </a>
      </div>
    </div>
    <div class="flex md:px-0 px-8 mb-0">
      <img
        id="hero"
        src=""
        alt=""
        class="w-fit h-fit md:rounded-none rounded-2xl md:bg-transparent bg-primary backdrop-blur bg-opacity-75"
      />
    </div>
  </div>
</main>

<style>
  img {
    mask-image: linear-gradient(black 50%, transparent);
  }
</style>
