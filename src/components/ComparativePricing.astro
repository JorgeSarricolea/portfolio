---
import pricing from "@/js/objects/pricing.js";
import comparativeFeatures from "@/js/objects/comparativeFeatures.js";
---

<div
  class="bg-gray rounded-2xl p-8 mb-20 shadow-lg border-2 border-gray-dark hover:border-primary transition-all duration-300"
>
  <h2
    class="text-primary text-3xl mb-8 text-center flex items-center justify-center gap-2"
  >
    Planes de Pago Único
  </h2>
  <div class="space-y-4 mb-8">
    <p class="text-white text-xl text-center font-semibold animate-fade-in-up">
      ¿Buscas algo permanente sin pagos mensuales? 🤔
    </p>
    <p
      class="text-white text-lg text-center opacity-90 animate-fade-in-up animation-delay-200"
    >
      Obtén tu plataforma con un solo pago y sin compromisos mensuales ni
      anuales.
    </p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-white">
      <thead>
        <tr class="border-b-2 border-primary">
          <th class="py-4 px-4 text-left">Características</th>
          {
            pricing.plans.map((plan) => (
              <th class="py-4 px-4 text-center">
                <div class="flex flex-col items-center">
                  <span class="text-2xl mb-2">{plan.emoji}</span>
                  <span class="text-primary font-semibold hover:text-accent transition-colors duration-300">
                    {plan.name}
                  </span>
                  <span class="text-2xl text-primary mt-2 font-bold">
                    ${plan.oneTimePrice.toLocaleString()}
                  </span>
                </div>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          comparativeFeatures.features.map((feature) => (
            <tr class="border-b border-gray-dark hover:bg-gray-dark transition-colors duration-200">
              <td class="py-4 px-4 font-bold">{feature.name}</td>
              {Object.entries(feature.values).map(([plan, value]) => (
                <td class="text-center py-4 px-4">
                  {value.type === "check" && (
                    <span class="text-primary text-xl">✅</span>
                  )}
                  {value.type === "minus" && (
                    <span class="text-gray-light text-xl">❌</span>
                  )}
                  {value.type === "text" && (
                    <span class="text-accent">{value.value}</span>
                  )}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }
</style>
