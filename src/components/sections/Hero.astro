---
import cv from "@/js/objects/cv/cv.js";
---

<section class="flex justify-between gap-36">
  <div>
    <h1 class="text-xl font-bold uppercase">{cv["basics"].name}</h1>
    <h2 class="mt-2">{cv["basics"].label}</h2>
    <div class="flex gap-4 mt-2 text-xs">
      <a
        href=`mailto:${cv["basics"].email}`
        class="hover:text-secondary flex items-center gap-2"
      >
        <i class="fa-solid fa-envelope"></i>
        {cv["basics"].email}
      </a>
      <a
        href={cv["basics"].phone}
        class="hover:text-secondary flex items-center gap-2"
      >
        <i class="fa-solid fa-phone"></i>
        {cv["basics"].phone}
      </a>
    </div>
    <div class="flex gap-4 mt-2 text-xs">
      <a
        href={cv["social"].portfolio}
        class="hover:text-secondary flex items-center gap-2"
      >
        <i class="fa-solid fa-briefcase"></i>
        Portfolio
      </a>
      <a
        href={cv["social"].github}
        class="hover:text-secondary flex items-center gap-2"
      >
        <i class="fa-brands fa-github"></i>
        GitHub
      </a>
      <a
        href={cv["social"].linkedin}
        class="hover:text-secondary flex items-center gap-2"
      >
        <i class="fa-brands fa-linkedin"></i>
        LinkedIn
      </a>
    </div>
  </div>
  <img
    id="cv-picture"
    src=""
    alt=""
    class="bg-secondary backdrop-blur rounded-2xl w-32 h-32 object-cover"
  />
</section>
