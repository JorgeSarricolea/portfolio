---
import { skillsByCategory } from "@/js/objects/skills.js";
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
/>

<section class="py-24 px-6">
  <div class="max-w-5xl mx-auto">
    <div data-motion-header>
      <h2 class="text-sm font-mono text-primary mb-3 tracking-wide">About Me</h2>
      <h3 class="text-3xl md:text-4xl font-bold text-white mb-6">
        A bit about what I do<span class="text-amber">.</span>
      </h3>

      <p class="text-gray-400 text-base md:text-lg leading-relaxed max-w-2xl mb-16">
      I'm a Software Engineer with 4+ years of experience building web applications
      end-to-end. I care about clean architecture, performance, and shipping products
      that people actually want to use. Currently working on enterprise platforms at
      scale.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {skillsByCategory.map((category) => (
        <div data-motion-item class="bg-surface rounded-xl p-5 border border-white/5 hover:border-primary/20 transition-all duration-300 hover:-translate-y-1">
          <h4 class="flex items-center gap-2 text-white text-sm font-semibold mb-4">
            <span class="material-symbols-outlined text-primary text-lg leading-none" aria-hidden="true">
              {category.categoryIcon}
            </span>
            {category.title}
          </h4>
          <div class="flex flex-wrap gap-2">
            {category.items.map((skill) => (
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-surface-light text-gray-400 text-xs hover:text-primary hover:bg-primary/10 transition-colors duration-200">
                <img
                  src={`/icons/${skill.icon}`}
                  alt={skill.name}
                  class="w-3.5 h-3.5 object-contain"
                  onerror="this.style.display='none'"
                  loading="lazy"
                />
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .material-symbols-outlined {
    font-variation-settings:
      "FILL" 0,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>
