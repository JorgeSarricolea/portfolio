---
import Layout from "../layouts/Layout.astro";
import "../styles/birthday.css";
import MatrixRain from "../components/MatrixRain.astro";
---

<Layout
  title="birthday()"
  description="Ha llegado el momento de celebrar otro nivel desbloqueado"
>
  <MatrixRain />
  <main class="birthday-container">
    <div class="terminal">
      <div class="terminal-header">
        <div class="terminal-buttons">
          <button class="terminal-button close"></button>
          <button class="terminal-button minimize"></button>
          <button class="terminal-button maximize"></button>
        </div>
        <div class="terminal-title">Jorge's Birthday Bash</div>
      </div>

      <div class="terminal-content">
        <div class="command-line">
          <span class="command"
            ><span class="prompt">$</span> Jorge.Birthday()</span
          >
          <div class="version-badge">
            <span class="version-label">v24.0.0</span>
            <span class="version-tag">LTS</span>
          </div>
        </div>
        <section class="welcome-section">
          <div class="output">
            <div class="info-grid">
              <div class="info-content">
                <div class="info-card">
                  <h3>🎉 Evento</h3>
                  <p>Cumpleaños de Jorge</p>
                  <p class="sub-text">
                    ¡Ha llegado el momento de celebrar otro nivel desbloqueado!
                    🎮
                  </p>
                </div>

                <div class="info-card">
                  <h3>📅 Fecha y Hora</h3>
                  <p>18 de Junio de 2025</p>
                  <p class="sub-text">7:30 PM</p>
                  <button
                    onclick="window.open('https://calendar.google.com/calendar/render?action=TEMPLATE&text=🎉 Cumpleaños de Jorge 🎂&dates=20250618T193000/20250618T233000&location=Mr. Pampas Mérida, Calle 60 # 329 x 33 y 35, Centro, 97000 Mérida, Yuc.&details=¡Ha llegado el momento de celebrar otro nivel desbloqueado! 🎮', '_blank')"
                    class="calendar-button"
                  >
                    Agregar a Google Calendar
                  </button>
                </div>

                <div class="info-card">
                  <h3>📍 Ubicación</h3>
                  <p>Mr. Pampas Mérida</p>
                  <p class="sub-text">
                    Calle 60 # 329 x 33 y 35, Centro, 97000 Mérida, Yuc.
                  </p>
                </div>

                <div class="info-card">
                  <h3>🎁 Regalos</h3>
                  <p>Opcionales</p>
                  <p class="sub-text">
                    (pero los regalos hechos con cariño siempre serán
                    bienvenidos)
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="countdown-section">
          <div class="command-line">
            <span class="command"
              ><span class="prompt">$</span> countdown --event birthday</span
            >
          </div>
          <div class="output">
            <div id="countdown" class="countdown-timer">
              <div class="time-block">
                <span id="days">00</span>
                <span class="label">Días</span>
              </div>
              <div class="time-block">
                <span id="hours">00</span>
                <span class="label">Horas</span>
              </div>
              <div class="time-block">
                <span id="minutes">00</span>
                <span class="label">Minutos</span>
              </div>
              <div class="time-block">
                <span id="seconds">00</span>
                <span class="label">Segundos</span>
              </div>
            </div>
          </div>
        </section>

        <section class="location-section">
          <div class="command-line">
            <span class="command"
              ><span class="prompt">$</span> map --show-location</span
            >
          </div>
          <div class="output">
            <div class="location-info">
              <h3>Mr. Pampas Mérida</h3>
              <p>Calle 60 # 329 x 33 y 35, Centro, 97000 Mérida, Yuc.</p>
              <div class="map-container">
                <iframe
                  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3724.8002901921777!2d-89.615194!3d21.0006411!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f5676b286af5013%3A0x355e5da59a82a317!2sMr.%20Pampas%20M%C3%A9rida!5e0!3m2!1ses-419!2smx!4v1749251161619!5m2!1ses-419!2smx"
                  width="100%"
                  height="450"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                >
                </iframe>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </main>
</Layout>

<script>
  // Countdown Timer
  const birthdayDate = new Date("2025-06-18T19:00:00").getTime();

  function updateCountdown() {
    const now = new Date().getTime();
    const distance = birthdayDate - now;

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
    );
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    document.getElementById("days").textContent = String(days).padStart(2, "0");
    document.getElementById("hours").textContent = String(hours).padStart(
      2,
      "0"
    );
    document.getElementById("minutes").textContent = String(minutes).padStart(
      2,
      "0"
    );
    document.getElementById("seconds").textContent = String(seconds).padStart(
      2,
      "0"
    );
  }

  setInterval(updateCountdown, 1000);
  updateCountdown();
</script>
