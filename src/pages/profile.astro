---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ProfilePhoto from "@/components/ProfilePhoto.astro";

const links = [
  { href: "/services", label: "Services", icon: "fa-tag", external: false },
  { href: "/cv_jorge_sarricolea.pdf", label: "Download Resume", icon: "fa-file-pdf", external: true },
  { href: "mailto:jjorgesarricolea18@gmail.com", label: "Email Me", icon: "fa-envelope", external: false },
];

const socials = [
  { href: "https://github.com/JorgeSarricolea", label: "GitHub", icon: "fa-github" },
  { href: "https://linkedin.com/in/jorgesarricolea", label: "LinkedIn", icon: "fa-linkedin" },
  { href: "https://instagram.com/jorgesarricolea_", label: "Instagram", icon: "fa-instagram" },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jorgesarricolea.com/profile" />
    <meta property="og:title" content="Jorge Sarricolea — Links" />
    <meta
      property="og:description"
      content="Connect with Jorge Sarricolea — portfolio, services, resume, and contact."
    />
    <meta property="og:image" content="/img/cartoon_jorge.png" />
    <meta
      name="description"
      content="Links to Jorge Sarricolea's portfolio, services, resume, and contact."
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <title>Jorge Sarricolea — Links</title>
  </head>

  <body class="bg-dark text-white antialiased selection:bg-primary/30 selection:text-white min-h-screen flex flex-col">
    <Header />

    <main class="flex-1 flex items-center justify-center px-6 pt-24 pb-8">
      <div class="w-full max-w-md">
        <div class="flex flex-col items-center text-center mb-10">
          <div class="mb-6">
            <ProfilePhoto sizeClass="w-28 h-28" showPulse={false} />
          </div>

          <p class="text-primary font-mono text-sm mb-2 tracking-wide">Hi, I'm</p>
          <h1 class="text-3xl font-extrabold text-white leading-tight">
            Jorge Sarricolea<span class="text-amber">.</span>
          </h1>
          <p class="text-gray-400 mt-2">Full-Stack Engineer · Remote</p>

          <div class="flex items-center gap-5 mt-6">
            {
              socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 hover:text-primary hover:-translate-y-1 transition-all duration-300"
                  aria-label={social.label}
                >
                  <i class={`fab ${social.icon} text-2xl`}></i>
                </a>
              ))
            }
          </div>
        </div>

        <div class="space-y-3">
          {
            links.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="group flex items-center justify-between bg-surface rounded-xl border border-white/5 p-4 transition-all duration-300 hover:border-primary/20 hover:-translate-y-0.5"
              >
                <div class="flex items-center gap-3">
                  <i class={`fa-solid ${link.icon} text-primary`}></i>
                  <span class="font-medium text-white">{link.label}</span>
                </div>
                <i class="fa-solid fa-arrow-right text-gray-600 group-hover:text-primary transition-colors duration-300"></i>
              </a>
            ))
          }
        </div>

        <p class="mt-10 text-center">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-primary transition-colors duration-300"
          >
            <i class="fa-solid fa-arrow-left text-xs"></i>
            Back to portfolio
          </a>
        </p>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
</style>
