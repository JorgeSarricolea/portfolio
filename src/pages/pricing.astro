---
import Header from "@/components/Header.astro";
import PriceToggle from "@/components/PriceToggle.astro";
import ComparativePricing from "@/components/ComparativePricing.astro";
import pricing from "@/js/objects/pricing.js";

const isAnnual = false; // Default to monthly pricing
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <!-- Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jorgesarricolea.com/pricing" />
    <meta property="og:title" content="Zentura | Pricing Plans" />
    <meta
      property="og:description"
      content="Discover our flexible pricing plans designed to help you grow your business online."
    />
    <meta property="og:image" content="/img/pricing-illustration.png" />
    <meta
      name="description"
      content="Flexible subscription plans: monthly, yearly, or one-time payment. Choose the best option for your business growth."
    />
    <!-- CDN Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <title>Pricing</title>
  </head>
  <body class="bg-black lg:w-4/6 m-auto mt-36">
    <Header />
    <section class="w-full md:max-w-full md:px-0 px-8">
      <div
        class="flex flex-col md:flex-row items-center gap-8 max-w-6xl mx-auto mb-12"
      >
        <div class="md:w-1/2">
          <h1 class="text-primary text-4xl font-bold mb-6">
            Planes de Suscripción
          </h1>
          <p class="text-white text-2xl font-semibold mb-4">
            Soluciones a tu medida
          </p>
          <p class="text-white leading-relaxed text-lg">
            Planes mensuales flexibles, anuales con descuento, o pago único.
            Diseñados para maximizar el valor y garantizar el éxito de tu
            proyecto.
          </p>
        </div>
        <div class="md:w-1/2">
          <img
            src="/img/pricing-illustration.svg"
            alt="Pricing Plans Illustration"
            class="w-full h-auto rounded-2xl object-cover hover:scale-105 transition-all duration-300"
            onerror="this.src='/img/pricing-illustration.png'"
          />
        </div>
      </div>

      <PriceToggle isAnnual={isAnnual} />

      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20 place-items-center max-w-7xl mx-auto"
      >
        {
          pricing.plans.map((plan) => (
            <div
              class={`bg-gray rounded-2xl p-8 flex flex-col justify-between items-center hover:scale-105 transition-all duration-300 border-2 shadow-lg w-full max-w-sm ${
                plan.isPopular
                  ? "border-primary shadow-primary/20 lg:scale-105 lg:-translate-y-4 lg:p-10 z-10"
                  : "border-gray-dark hover:border-primary hover:shadow-primary/20"
              }`}
            >
              <div>
                <div class="text-primary uppercase text-2xl mb-4 font-bold flex items-center gap-2">
                  {plan.emoji} {plan.name}
                </div>
                <div class="text-white mb-6">{plan.tagline}</div>

                {/* Monthly/Annual toggle prices */}
                <div class="text-white mb-8">
                  <div data-price-monthly class="text-3xl mb-2">
                    <span class="text-primary font-bold">
                      ${plan.monthlyPrice.toLocaleString()}
                    </span>
                    <span class="text-sm">/ mes</span>
                  </div>
                  <div data-price-yearly class="text-3xl mb-2 hidden">
                    <span class="text-primary font-bold">
                      ${plan.yearlyPrice.toLocaleString()}
                    </span>
                    <span class="text-sm">/ año</span>
                    <div class="text-accent text-sm">
                      ~${plan.yearlyPricePerMonth}/mes
                    </div>
                  </div>
                </div>

                <ul class="text-white space-y-3 mb-8">
                  {plan.features.map((feature) => (
                    <li class="flex items-center gap-2">
                      <span class="text-primary">✅</span>
                      {feature}
                    </li>
                  ))}
                </ul>
              </div>
              <a
                href={`https://wa.me/529381095593?text=${encodeURIComponent(plan.whatsappMessage)}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-full py-3 rounded-xl transition-all duration-300 font-semibold text-center ${
                  plan.isPopular
                    ? "bg-primary text-black hover:bg-accent hover:scale-105"
                    : "bg-gray-dark text-white hover:bg-accent"
                }`}
              >
                {plan.isPopular ? "¡Empezar ahora! 🚀" : "Seleccionar plan"}
              </a>
            </div>
          ))
        }
      </div>

      <ComparativePricing />

      <!-- Add-ons Section -->
      <div
        class="bg-gray rounded-2xl p-8 mb-20 border-2 border-gray-dark hover:border-primary transition-all duration-300 shadow-lg"
      >
        <h2
          class="text-primary text-3xl mb-8 flex items-center justify-center gap-2"
        >
          Extras opcionales <span class="text-accent">(Add-ons)</span>
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            pricing.addons.map((addon) => (
              <div class="text-white p-6 bg-gray-dark rounded-xl hover:scale-105 transition-all duration-300">
                <h3 class="font-bold mb-2 flex items-center gap-2">
                  <span class="text-primary">💎</span> {addon.title}
                </h3>
                <p class="text-sm opacity-75">{addon.description}</p>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Contact Section -->
      <div
        class="text-center mb-20 bg-gray p-8 rounded-2xl border-2 border-gray-dark hover:border-primary transition-all duration-300 shadow-lg"
      >
        <h2
          class="text-white text-2xl mb-4 flex items-center justify-center gap-2"
        >
          {pricing.contact.title}
        </h2>
        <p class="text-white opacity-75 mb-8">{pricing.contact.description}</p>
        <a
          href={`https://wa.me/529381095593?text=${encodeURIComponent(pricing.contact.whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block w-fit bg-primary text-black px-8 py-3 rounded-xl hover:bg-accent transition-all duration-300 font-semibold items-center gap-2 justify-center"
        >
          <span>💬</span> Contactar por WhatsApp
        </a>
      </div>
    </section>
  </body>
</html>
